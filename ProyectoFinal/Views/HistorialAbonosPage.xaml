<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.HistorialAbonosPage"
             Title="Historial de Abonos"
             BackgroundColor="{StaticResource LightSea}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Frame Grid.Row="0"
               Padding="20"
               CornerRadius="0"
               BorderColor="Transparent"
               BackgroundColor="{StaticResource Primary}"
               HasShadow="True">
            <Label Text="📜 Historial de Abonos"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          x:Name="LoadingIndicator"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

        <!-- Scroll View -->
        <ScrollView Grid.Row="1" x:Name="AbonosScrollView">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Info de la compra -->
                <Frame Padding="15"
                       CornerRadius="15"
                       BorderColor="Transparent"
                       BackgroundColor="White"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="5">
                        <Label x:Name="ProductoLabel"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"/>
                        <Label x:Name="InfoLabel"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Mensaje cuando no hay abonos -->
                <Frame x:Name="EmptyFrame"
                       IsVisible="False"
                       Padding="30"
                       CornerRadius="15"
                       BorderColor="Transparent"
                       BackgroundColor="White"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="💸"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="No hay abonos registrados"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- CollectionView de abonos -->
                <CollectionView x:Name="AbonosCollection"
                               SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   CornerRadius="15"
                                   BorderColor="Transparent"
                                   BackgroundColor="White"
                                   HasShadow="True"
                                   Margin="0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">

                                    <!-- Emoji -->
                                    <Label Grid.Column="0"
                                           Text="💰"
                                           FontSize="32"
                                           VerticalOptions="Center"/>

                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Tipo}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"/>
                                        <Label Text="{Binding FechaAbono, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"/>
                                    </VerticalStackLayout>

                                    <!-- Monto -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Monto, StringFormat='{0:C}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}"
                                           VerticalOptions="Center"/>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
