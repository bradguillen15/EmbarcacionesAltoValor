<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.RegistrarCompraPage"
             Title="Registrar Compra"
             BackgroundColor="{StaticResource LightSea}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="{StaticResource Primary}"
                   HasShadow="True">
                <Label Text="💳 Nueva Compra"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </Frame>

            <!-- Información del Producto -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Producto Seleccionado"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Label x:Name="ProductoNombreLabel"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"/>

                    <Label x:Name="ProductoDetalleLabel"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}"/>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}"
                             Margin="0,10"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="Precio Base:"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray600}"/>
                        <Label Grid.Column="1"
                               x:Name="PrecioBaseLabel"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Prima Inicial -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Prima Inicial"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Slider x:Name="PrimaSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                Value="20"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{StaticResource Gray300}"
                                ThumbColor="{StaticResource Primary}"
                                ValueChanged="OnPrimaSliderChanged"/>

                        <Label Grid.Column="1"
                               x:Name="PrimaPorcentajeLabel"
                               Text="20%"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               WidthRequest="60"
                               HorizontalTextAlignment="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,5,0,0">
                        <Label Grid.Column="0"
                               Text="Monto Prima:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"/>
                        <Label Grid.Column="1"
                               x:Name="MontoPrimaLabel"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}"
                               HorizontalOptions="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="A Financiar:"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"/>
                        <Label Grid.Column="1"
                               x:Name="MontoFinanciarLabel"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Tertiary}"
                               HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Plazo en Meses -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Plazo de Financiamiento"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Picker x:Name="PlazoPicker"
                            Title="Seleccione el plazo"
                            FontSize="16"
                            TextColor="{StaticResource Gray900}"
                            BackgroundColor="{StaticResource LightSea}"
                            SelectedIndexChanged="OnPlazoSelectionChanged">
                        <Picker.Items>
                            <x:String>12 meses</x:String>
                            <x:String>24 meses</x:String>
                            <x:String>36 meses</x:String>
                            <x:String>48 meses</x:String>
                            <x:String>60 meses</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <!-- Tasa de Interés -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tasa de Interés Anual"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="TasaInteresEntry"
                               Grid.Column="0"
                               Keyboard="Numeric"
                               Placeholder="Ingrese tasa (mínimo 10%)"
                               Text="15"
                               FontSize="16"
                               BackgroundColor="{StaticResource LightSea}"
                               TextChanged="OnTasaInteresChanged"/>

                        <Label Grid.Column="1"
                               Text="%"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Label x:Name="TasaErrorLabel"
                           Text="⚠️ La tasa mínima es 10%"
                           FontSize="12"
                           TextColor="Red"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Resumen -->
            <Frame Padding="0"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <Grid RowDefinitions="Auto,Auto">

                    <!-- Header del Resumen -->
                    <Frame Grid.Row="0"
                           Padding="20,15"
                           BorderColor="Transparent"
                           BackgroundColor="{StaticResource Primary}"
                           HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="📊"
                                   FontSize="24"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Resumen de la Compra"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <!-- Contenido del Resumen -->
                    <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="15">

                        <!-- Precio Total -->
                        <Frame Padding="15"
                               CornerRadius="12"
                               BorderColor="Transparent"
                               BackgroundColor="#F0F9FF"
                               HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Precio Total"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}"/>
                                    <Label x:Name="ResumenPrecioLabel"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="💰"
                                       FontSize="32"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <!-- Grid con Prima y Monto a Financiar -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <!-- Prima Inicial -->
                            <Frame Grid.Column="0"
                                   Padding="15"
                                   CornerRadius="12"
                                   BorderColor="Transparent"
                                   BackgroundColor="#F0FDF4"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="💵"
                                           FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Prima Inicial"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray600}"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="ResumenPrimaLabel"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#059669"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Monto a Financiar -->
                            <Frame Grid.Column="1"
                                   Padding="15"
                                   CornerRadius="12"
                                   BorderColor="Transparent"
                                   BackgroundColor="#FEF3C7"
                                   HasShadow="False">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="📈"
                                           FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="A Financiar"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray600}"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="ResumenFinanciarLabel"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#D97706"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"
                                 Margin="0,5"/>

                        <!-- Detalles: Plazo y Tasa -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15" RowSpacing="10">

                            <!-- Plazo -->
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="⏱️"
                                       FontSize="18"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Plazo"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray600}"/>
                                    <Label x:Name="ResumenPlazoLabel"
                                           Text="-"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Tasa de Interés -->
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="📊"
                                       FontSize="18"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tasa Anual"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray600}"/>
                                    <Label x:Name="ResumenTasaLabel"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Botones -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCancelarClicked"/>

                <Button Grid.Column="1"
                        x:Name="ConfirmarButton"
                        Text="Confirmar Compra"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnConfirmarClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
