<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.AyudaPage"
             Title="Ayuda"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Centro de Ayuda"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White" />

            <Label Text="Encuentra información para usar la aplicación correctamente"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#D1D5DB"
                   Margin="0,0,0,10"/>

            <!-- Cómo usar la app -->
            <Frame CornerRadius="15"
                   Padding="15"
                   BackgroundColor="#F5F5F5"
                   BorderColor="#DDDDDD">
                <VerticalStackLayout Spacing="10">

                    <Label Text="¿Cómo usar la aplicación?"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <Label Text="1. Gestión de Compras: Registra nuevas compras de productos."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="2. Abonos: Realiza pagos parciales o totales sobre una compra."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="3. Consultas: Visualiza el historial completo de compras y abonos."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="4. Notificaciones: Recibe alertas sobre vencimientos o pagos."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="5. Reportes: Genera reportes financieros de tus compras."
                           FontSize="14"
                           TextColor="#374151"/>
                </VerticalStackLayout>
            </Frame>

            <!-- FAQ -->
            <Frame CornerRadius="15"
                   Padding="15"
                   BackgroundColor="White"
                   BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Preguntas Frecuentes"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <Label Text="¿Cómo registrar una compra?"
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Label Text="Ir a 'Gestión de Compras', completar los datos del producto y guardar."
                           FontSize="13"
                           TextColor="#6B7280"/>

                    <Label Text="¿Cómo hacer un abono?"
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Label Text="Ir a 'Abonos', seleccionar la compra y registrar el monto."
                           FontSize="13"
                           TextColor="#6B7280"/>

                    <Label Text="¿Cómo ver mi saldo pendiente?"
                           FontAttributes="Bold"
                           TextColor="#111827"/>
                    <Label Text="En 'Consultas', selecciona la compra para ver detalles y saldo restante."
                           FontSize="13"
                           TextColor="#6B7280"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Recomendaciones -->
            <Frame CornerRadius="15"
                   Padding="15"
                   BackgroundColor="#E8F0FE"
                   BorderColor="#D6E4FF">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Recomendaciones"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <Label Text="• Mantén tus datos actualizados."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="• Revisa las notificaciones para evitar atrasos."
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="• Guarda correctamente cada compra para llevar control financiero."
                           FontSize="14"
                           TextColor="#374151"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Soporte -->
            <Frame CornerRadius="15"
                   Padding="15"
                   BackgroundColor="#FFF3E0"
                   BorderColor="#F3D7A6">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Soporte"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <Label Text="Email: soporte@puravidayachts.com"
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="Teléfono: +506 0000-0000"
                           FontSize="14"
                           TextColor="#374151"/>

                    <Label Text="Horario: Lunes a Viernes 8:00 AM - 6:00 PM"
                           FontSize="14"
                           TextColor="#374151"/>

                    <Button Text="Contactar Soporte"
                            Clicked="OnContactarClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Volver al Menú"
                    Clicked="OnVolverClicked"
                    BackgroundColor="#6B7280"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>