<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.GestionComprasPage"
             Title="Mis Compras"
             BackgroundColor="{StaticResource LightSea}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Frame Grid.Row="0"
               Padding="20"
               CornerRadius="0"
               BorderColor="Transparent"
               BackgroundColor="{StaticResource Primary}"
               HasShadow="True">
            <Label Text="🛍️ Mis Compras"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          x:Name="LoadingIndicator"
                          IsRunning="False"
                          IsVisible="False"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center"/>

        <!-- Scroll View con lista de compras -->
        <ScrollView Grid.Row="1" x:Name="ComprasScrollView">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- Mensaje cuando no hay compras -->
                <Frame x:Name="EmptyFrame"
                       IsVisible="False"
                       Padding="30"
                       CornerRadius="15"
                       BorderColor="Transparent"
                       BackgroundColor="White"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🛒"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="No tienes compras aún"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"/>
                        <Label Text="Visita el catálogo para comprar tu primera embarcación"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- CollectionView de compras -->
                <CollectionView x:Name="ComprasCollection"
                               SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   CornerRadius="15"
                                   BorderColor="Transparent"
                                   BackgroundColor="White"
                                   HasShadow="True"
                                   Margin="0,5">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="10">

                                    <!-- Nombre del producto -->
                                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Producto.Nombre}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"/>

                                    <!-- Detalles del producto -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray600}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Producto.TipoBien}" FontAttributes="Bold"/>
                                                <Span Text=" • "/>
                                                <Span Text="{Binding Producto.Marca}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Separador -->
                                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                             HeightRequest="1"
                                             Color="{StaticResource Gray200}"/>

                                    <!-- Info financiera -->
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="5">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="💰 Total:"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}"/>
                                            <Label Text="{Binding PrecioTotal, StringFormat='{0:C}'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="📅 Plazo:"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}"/>
                                            <Label Text="{Binding PlazoMeses, StringFormat='{0} meses'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray900}"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="📊 Estado:"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray600}"/>
                                            <Label Text="{Binding Estado}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Secondary}"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Fecha -->
                                    <Label Grid.Row="3" Grid.Column="1"
                                           Text="{Binding FechaRegistro, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Start"
                                           HorizontalOptions="End"/>

                                    <!-- Botón Ver Detalles -->
                                    <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="Ver Detalles"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            CornerRadius="10"
                                            HeightRequest="40"
                                            Clicked="OnVerDetallesClicked"
                                            CommandParameter="{Binding .}"/>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
