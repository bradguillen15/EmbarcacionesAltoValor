<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.NotificacionesPage"
             Title="Notificaciones"
             BackgroundColor="{StaticResource LightSea}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="{StaticResource Primary}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="📧 Notificaciones por Correo"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Configure los correos que recibirán alertas automáticas"
                           FontSize="13"
                           TextColor="#B3D9F5"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Info automática -->
            <Frame Padding="15"
                   CornerRadius="12"
                   BorderColor="Transparent"
                   BackgroundColor="#FFFBEB"
                   HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="💡" FontSize="20" VerticalOptions="Center"/>
                    <Label Text="Se envía un correo automáticamente al registrar una compra o un abono."
                           FontSize="13"
                           TextColor="#92400E"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Configuración de emails -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="✉️ Configuración de Correos"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>

                    <!-- Email primario -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo primario *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray600}"/>
                        <Entry x:Name="EmailPrimarioEntry"
                               Keyboard="Email"
                               Placeholder="tucorreo@gmail.com"
                               FontSize="15"
                               BackgroundColor="{StaticResource LightSea}"
                               ClearButtonVisibility="WhileEditing"/>
                        <Label Text="* Este correo siempre recibirá las notificaciones"
                               FontSize="11"
                               TextColor="{StaticResource Gray600}"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>

                    <!-- Email secundario -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo secundario (opcional)"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray600}"/>
                        <Entry x:Name="EmailSecundarioEntry"
                               Keyboard="Email"
                               Placeholder="otro@gmail.com (opcional)"
                               FontSize="15"
                               BackgroundColor="{StaticResource LightSea}"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <!-- Botón guardar -->
                    <Button Text="💾 Guardar Configuración"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="50"
                            Clicked="OnGuardarClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Prueba de notificación -->
            <Frame Padding="20"
                   CornerRadius="15"
                   BorderColor="Transparent"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🧪 Probar Notificación"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Envía un correo de prueba al correo primario configurado para verificar que funciona."
                           FontSize="13"
                           TextColor="{StaticResource Gray600}"/>

                    <ActivityIndicator x:Name="EnviandoIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource Primary}"/>

                    <Button Text="📤 Enviar Correo de Prueba"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            Clicked="OnProbarClicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
