<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.RealizarPagoPage"
             Title="RealizarPagoPage"
             BackgroundColor="{StaticResource LightSea}">
    
    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <!-- Título -->
            <Label
                Text="Digite la información necesaria"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource Primary}"/>

            <!-- Cuadro blanco que contiene todo -->
            <Frame Padding="20,20,20,20" 
               CornerRadius="15" 
               BorderColor="Transparent" 
               HasShadow="True" 
               BackgroundColor="{StaticResource White}"/>

            <VerticalStackLayout Spacing="2">
                <Frame
                    Padding="20"
                    CornerRadius="10"
                    BorderColor="Transparent"
                    BackgroundColor="White"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="15">

                        <!-- Picker donde se selecciona el metodo de pago -->
                        <Label FontAttributes="Bold" />
                        <Picker x:Name="PickerMetodo_Pago" Title="Seleccione el método de pago" TitleColor="{StaticResource Gray600}" BackgroundColor="{StaticResource Primary}">
                            <Picker.Items>
                                <x:String>Tarjeta de débito</x:String>
                                <x:String>Tarjeta de crédito</x:String>
                                <x:String>Transferencia bancaria</x:String>
                            </Picker.Items>
                        </Picker>

                        <!-- Linea azul entre elementos -->
                        <BoxView HeightRequest="1"
                             Color="{StaticResource LightSea}"
                             HorizontalOptions="Fill"/>

                        <!-- Picker donde se selecciona el vehiculo -->
                        <Label FontAttributes="Bold" />
                        <Picker x:Name="PickerVehiculo"
                            Title="Seleccione el vehiculo que desea pagar"
                            TitleColor="{StaticResource Gray600}"
                            BackgroundColor="{StaticResource Primary}"
                            ItemDisplayBinding="{Binding Display}" />


                        <!-- Linea azul entre elementos -->
                        <BoxView HeightRequest="1"
                         Color="{StaticResource LightSea}"
                         HorizontalOptions="Fill"/>
                        
                        <!-- Entry del monto -->
                        <Label FontAttributes="Bold" />
                        <Entry
                            x:Name="MontoEntry"
                            Keyboard="Numeric"
                            TextColor="{StaticResource Primary}"
                            Placeholder="Digite el monto que desea pagar" />
                        
                        <!-- Botón hacer pago -->
                        <Button
                            x:Name="HacerPagoButton"
                            Text="Realizar pago"
                            Clicked="OnHacerPagoClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,10,0,0" />

                        <!-- Botón salir -->
                        <Button Text="Atrás"
                            BackgroundColor="White"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            Clicked="OnSalirClicked"
                            BorderWidth="2"
                            CornerRadius="10"
                            HeightRequest="45"
                            x:Name="BtnSalir"/>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>